# Documentation only: processes do not automatically load this file.
# Native alpha defaults. Supply credentials through private *_FILE paths.
SANDBOX_ENABLED=true
LIVE_MODEL_ENABLED=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_TLS=false
BUSINESS_API=http://127.0.0.1:8080
WEB_ORIGIN=http://localhost:5173
API_BIND=127.0.0.1
PORT=8080
WORKER_HEALTH_BIND=127.0.0.1
WORKER_SECRET_FILE=runtime/native/worker-secret
# Live mode requires private sessions, model/provider/secret-file configuration,
# and positive MODEL_MAX_USD_PER_MTOK / MODEL_DAILY_USD_LIMIT assumptions.
# See docs/PROVIDERS.md. No model identifier or price is assumed here.
